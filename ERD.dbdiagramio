// --- Unified Enum ---
enum reimbursement_status {
  Submitted             // User baru kirim
  Manager_Approved      // Manager ACC
  Manager_Rejected      // Ditolak Manager
  Finance_Approved      // Finance ACC
  Finance_Rejected      // Ditolak Finance
  Paid                  // Selesai
}

enum user_role {
  Employee
  Manager
  Finance
  Admin
}

// --- Tables ---

// 1. DATA PROFIL (Hanya identitas)
Table users {
  id int [pk, increment]
  employee_id varchar [unique]
  fullname varchar
  email varchar [unique]
  // Kolom password sudah DIPINDAH
  
  role user_role [not null]
  manager_id int [ref: > users.id]
  bank_account_number varchar
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// 2. DATA OTENTIKASI (Login & Security)
// Terpisah agar lebih aman dan modular
Table accounts {
  id int [pk, increment]
  user_id int [unique, not null] // Unique menandakan One-to-One
  
  password varchar [note: "Simpan hash password"]
  otp varchar [note: "Kode OTP sementara"]
  expired timestamp [note: "Waktu kadaluarsa OTP"]
  
  is_active boolean [default: true, note: "Status akun aktif/suspend"]
  is_used boolean [default: false, note: "Status apakah OTP sudah dipakai"]
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table categories {
  id int [pk, increment]
  name varchar
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table reimbursements {
  id int [pk, increment]
  user_id int [not null]
  category_id int [not null]
  title varchar 
  description text 
  amount decimal(15, 2) [not null]
  date_of_expense date
  receipt text [note: "Base64 String"]
  
  status reimbursement_status [default: 'Submitted']
  rejection_reason text 
  
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table approval_logs {
  id int [pk, increment]
  reimbursement_id int [not null]
  action_by_user_id int [not null]
  action reimbursement_status [not null]
  comments text 
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

Table disbursements {
  id int [pk, increment]
  reimbursement_id int [unique, not null] 
  processed_by_user_id int 
  amount_paid decimal(15, 2) 
  reference_number varchar 
  paid_at timestamp [default: `now()`]
  created_at timestamp [default: `now()`]
  updated_at timestamp [default: `now()`]
}

// --- Relationships ---
// Relasi One-to-One antara Users dan Accounts
Ref: accounts.user_id - users.id

Ref: reimbursements.user_id > users.id
Ref: reimbursements.category_id > categories.id
Ref: approval_logs.reimbursement_id > reimbursements.id
Ref: approval_logs.action_by_user_id > users.id
Ref: disbursements.reimbursement_id - reimbursements.id
Ref: disbursements.processed_by_user_id > users.id